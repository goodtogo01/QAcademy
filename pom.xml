<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Pinned to Spring Boot 3.5.16 (last OSS release of the 3.5 line, Java 17
         baseline) rather than Spring Boot 4.x. See README "Why Spring Boot 3.5,
         not 4.x" for the reasoning - short version: 4.x requires Java 21, moves to
         Jakarta-only + Hibernate 7 + Jackson 3 + Spring Security 7 with several
         breaking changes, and this project was hand-written without a compiler
         available to verify against an API surface that new. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath />
	</parent>

	<groupId>com.qacademy</groupId>
	<artifactId>qacademy</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>qAcademy</name>
	<description>School Management REST API - same layered-architecture concept
		as qEducation (.NET) and qCampus (.NET), reimplemented on Java, Spring
		Boot, Maven, and TestNG.</description>

	<properties>
		<java.version>17</java.version>

		<!-- Default TestNG suite for a bare "mvn test"/"mvn verify" - override with
		     -DsuiteXmlFile=src/test/resources/testing/testng-smoke.xml (or -api/-ui/-e2e).
		     This property is what actually makes that override work: the surefire plugin's
		     <suiteXmlFile> below reads it. -->
		<suiteXmlFile>src/test/resources/testing/testng-regression.xml</suiteXmlFile>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Schema migrations - the Java/Maven equivalent of qCampus's EF Core
             migrations. See src/main/resources/db/migration/V1__init.sql. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Swagger UI equivalent of Swashbuckle -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.5</version>
		</dependency>

		<!-- JWT - pinned to the well-established 0.11.x builder API. jjwt
		0.12.x+
             renamed most builder methods; 0.11.5 is the version whose exact API
             surface could be hand-written with confidence here. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Testing stack, per request: TestNG + Mockito instead of xUnit +
		Moq. -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.12.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- UI automation -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>4.27.0</version>
			<scope>test</scope>
		</dependency>

		<!-- API automation -->
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<version>5.5.0</version>
			<scope>test</scope>
		</dependency>

		<!-- Reporting -->
		<dependency>
			<groupId>com.aventstack</groupId>
			<artifactId>extentreports</artifactId>
			<version>5.1.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>qacademy</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Without this, "mvn test" only runs plain @Test-annotated JUnit-style
			     classes it finds by naming convention (*Test.java) with default
			     settings - it never looks at any TestNG suite XML, so none of the
			     <listeners>, <suite-files>, or hand-picked <include>/<exclude>
			     wiring in src/test/resources/testing/*.xml would ever take effect.
			     Defaulting to the regression suite means a bare "mvn test" runs
			     everything; pick a smaller lane with:
			       mvn test -DsuiteXmlFile=src/test/resources/testing/testng-smoke.xml -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<suiteXmlFiles>
						<suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
					</suiteXmlFiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
